<?xml version="1.0" encoding="utf-8"?>
<!-- PLAY: the one gold control on the page, so it reads as the thing to press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/wario_disabled" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wario_gold_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wario_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

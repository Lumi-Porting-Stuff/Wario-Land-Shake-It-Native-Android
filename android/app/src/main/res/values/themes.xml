<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The launcher: always dark, in the PC launcher's own colours rather than the phone's, so the
         two programs look like one. -->
    <style name="Theme.WarioRecomp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/wario_back</item>
        <item name="android:colorBackground">@color/wario_back</item>
        <item name="android:textColorPrimary">@color/wario_text</item>
        <item name="android:textColorSecondary">@color/wario_muted</item>
        <item name="colorAccent">@color/wario_gold</item>
        <item name="colorControlActivated">@color/wario_gold</item>
        <item name="colorControlNormal">@color/wario_field_border</item>
        <item name="android:statusBarColor">@color/wario_side</item>
        <item name="android:navigationBarColor">@color/wario_side</item>
    </style>

    <!-- The game: SDL draws every pixel, so nothing should be drawn behind or over it. -->
    <style name="Theme.WarioRecomp.Game" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
